[Desktop Entry]
Type=Application
Name=Epic Vector
GenericName=Vector Graphics Editor
Comment=Draw and edit vector illustrations, SVG and PDF
Exec=vectorcraft %F
TryExec=vectorcraft
Icon=io.github.prockstem.epicvector
Terminal=false
StartupNotify=true
StartupWMClass=io.github.prockstem.epicvector
Categories=Graphics;2DGraphics;VectorGraphics;
Keywords=vector;illustration;svg;pdf;drawing;bezier;
MimeType=image/svg+xml;application/pdf;
